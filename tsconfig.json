{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["node", "@astrojs/cloudflare"]
	},
	"include": [
		".astro/types.d.ts",
		"src/**/*.ts",
		"src/**/*.tsx",
		"src/**/*.astro"
	]
}
