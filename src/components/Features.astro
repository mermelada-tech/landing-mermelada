---
const mods = [
	{
		key: "mod/habilidades",
		color: "var(--grape-300)",
		title: "Desarrollo de habilidades",
		text: "Proyectos de código en equipo, eventos virtuales y cursos grabados en YouTube y Twitch.",
	},
	{
		key: "mod/networking",
		color: "var(--cyan)",
		title: "Conexiones",
		text: "Apoyo, inspiración y contactos de mujeres que comparten tus intereses y tus metas.",
	},
	{
		key: "mod/espacio-seguro",
		color: "var(--rasp)",
		title: "Espacio seguro",
		text: "Para todas, sin importar edad, origen, orientación sexual o identidad de género.",
	},
];
---

<section id="comunidad" style="padding-top:72px">
	<div class="wrap">
		<div class="sec-head">
			<div><p class="eyebrow">Qué hacemos</p><h2>Tres módulos. Una comunidad.</h2></div>
		</div>
		<div class="mods">
			{
				mods.map((m) => (
					<article class="card mod">
						<div class="k">
							<span>{m.key}</span>
							<i style={`background:${m.color}`} />
						</div>
						<h3>{m.title}</h3>
						<p>{m.text}</p>
					</article>
				))
			}
		</div>
	</div>
</section>
