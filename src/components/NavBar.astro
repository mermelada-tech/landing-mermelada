---
import Logo from "./Logo.astro";

interface Props {
	page: "home" | "mentorias";
}

const { page } = Astro.props;

const items = [
	{ label: "comunidad", href: "/#comunidad", key: "home" },
	{ label: "mentorias", href: "/mentorias", key: "mentorias" },
	{ label: "nosotras", href: "/#nosotras", key: "" },
	{ label: "testimonios", href: "/#testimonios", key: "" },
	{ label: "faq", href: "/#faq", key: "" },
];
---

<header class="nav">
	<div class="wrap">
		<a class="wm" href="/"><Logo />MERMELADA <b>TECH</b></a>
		<nav class="menu">
			{items.map((i) => <a href={i.href} class={i.key === page ? "on" : undefined}>{i.label}</a>)}
		</nav>
		<a class="btn y" href="/mentorias">Pedí tu mentoría</a>
		<a class="burger" href="/mentorias" aria-label="Pedí tu mentoría">→</a>
	</div>
</header>
