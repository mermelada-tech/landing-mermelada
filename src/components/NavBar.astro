---
interface NavLink {
	label: string;
	href: string;
}

const links: NavLink[] = [
	{ label: "Sobre mí", href: "#sobre-mi" },
	{ label: "Workshops", href: "#workshops" },
	{ label: "Mentorías", href: "#mentorias" },
];
---

<nav
	class="sticky top-0 z-50 flex items-center justify-between h-16 px-4 sm:px-6 bg-merme-paper border-b-[1.5px] border-merme-black"
>
	<a href="/" class="flex-shrink-0" aria-label="Mermelada Tech — inicio">
		<img src="/logo-mermelada.svg" alt="Mermelada Tech" class="h-9 w-auto" />
	</a>

	<!-- Desktop links -->
	<ul class="hidden md:flex items-center gap-1 list-none">
		{
			links.map((l) => (
				<li>
					<a
						href={l.href}
						class="px-3 py-2 font-medium text-merme-black hover:text-merme-purple transition-colors"
					>
						{l.label}
					</a>
				</li>
			))
		}
		<li class="pl-2">
			<a href="#mentorias" class="merme-btn text-sm py-2 px-4">Reservá una sesión</a>
		</li>
	</ul>

	<!-- Mobile menu toggle -->
	<button
		id="nav-toggle"
		class="md:hidden w-10 h-10 flex items-center justify-center border-[1.5px] border-merme-black rounded-md bg-white"
		aria-label="Abrir menú"
		aria-expanded="false"
		aria-controls="nav-mobile"
	>
		<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
			<line x1="3" y1="6" x2="21" y2="6"></line>
			<line x1="3" y1="12" x2="21" y2="12"></line>
			<line x1="3" y1="18" x2="21" y2="18"></line>
		</svg>
	</button>
</nav>

<!-- Mobile menu -->
<ul
	id="nav-mobile"
	class="hidden md:hidden flex-col gap-1 list-none px-4 py-3 bg-merme-paper border-b-[1.5px] border-merme-black"
>
	{
		links.map((l) => (
			<li>
				<a
					href={l.href}
					class="block px-3 py-3 font-medium text-merme-black hover:text-merme-purple transition-colors"
				>
					{l.label}
				</a>
			</li>
		))
	}
	<li class="pt-2">
		<a href="#mentorias" class="merme-btn w-full text-sm py-2.5">Reservá una sesión</a>
	</li>
</ul>

<script>
	const toggle = document.getElementById("nav-toggle");
	const menu = document.getElementById("nav-mobile");
	toggle?.addEventListener("click", () => {
		const open = menu?.classList.toggle("hidden") === false;
		toggle.setAttribute("aria-expanded", String(open));
	});
	// Close on link tap
	menu?.querySelectorAll("a").forEach((a) =>
		a.addEventListener("click", () => menu.classList.add("hidden")),
	);
</script>
