---
import { links } from "../data/links";

const socials = [
	{ name: "LinkedIn", href: links.linkedin },
	{ name: "X", href: links.twitter },
	{ name: "GitHub", href: links.github },
	{ name: "YouTube", href: links.youtube },
	{ name: "Twitch", href: links.twitch },
	{ name: "Discord", href: links.discord },
];
const year = new Date().getFullYear();
---

<footer>
	<div class="wrap">
		<span class="wm" style="font-size:15px">MERMELADA <b>TECH</b></span>
		<nav aria-label="Redes sociales">
			{socials.map((s) => <a href={s.href} target="_blank" rel="noopener noreferrer">{s.name}</a>)}
		</nav>
		<span>© {year} Mermelada Tech · {links.email}</span>
	</div>
</footer>
