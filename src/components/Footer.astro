---
import NewsletterForm from "./NewsletterForm.astro";

interface SocialLink {
	label: string;
	href: string;
	icon: string; // iconify bi/*
}

const socials: SocialLink[] = [
	{
		label: "LinkedIn",
		href: "https://linkedin.com/in/nadiaujovich",
		icon: "linkedin",
	},
	{
		label: "Instagram",
		href: "https://instagram.com/mermelada.techok",
		icon: "instagram",
	},
	{ label: "Discord", href: "https://discord.gg/HFV4QXJKNh", icon: "discord" },
];

const year = new Date().getFullYear();
---

<footer class="bg-merme-black text-white px-6 py-12">
	<div class="max-w-5xl mx-auto flex flex-col md:flex-row md:items-center gap-8 md:justify-between">
		<div>
			<img src="/logo-mermelada.png" alt="Mermelada Tech" class="h-14 w-auto" />
			<p class="text-white/70 mt-3 max-w-sm">
				Workshops y mentorías para mujeres que crecen en tecnología. Sumate a la comunidad.
			</p>
			<div class="mt-5 max-w-sm">
				<p class="text-white font-semibold mb-2 text-sm">Sumate al newsletter</p>
				<NewsletterForm variant="footer" />
			</div>
		</div>

		<nav aria-label="Redes y contacto" class="flex flex-col gap-3">
			{
				socials.map((s) => (
					<a
						href={s.href}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-3 text-white/90 hover:text-merme-sunflower transition-colors font-medium"
					>
						<img
							src={`https://api.iconify.design/bi/${s.icon}.svg?color=%23ffffff`}
							width="20"
							height="20"
							alt=""
							aria-hidden="true"
						/>
						{s.label}
					</a>
				))
			}
		</nav>
	</div>

	<div class="max-w-5xl mx-auto mt-10 pt-6 border-t border-white/20 text-white/60 text-sm">
		<p>© {year} Mermelada Tech — Hecho con ♥ y Astro</p>
	</div>
</footer>
