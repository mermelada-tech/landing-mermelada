---
import { links } from "../data/links";

const tags = [
	"Python",
	"JavaScript",
	"Data",
	"IA",
	"UX/UI",
	"Cloud",
	"QA",
	"Backend",
	"Product",
];
---

<section class="hero" id="inicio">
	<div class="wrap">
		<div>
			<span class="status"><i></i> +1.200 mujeres conectadas en Discord</span>
			<h1>¿Te apasiona la <em>tecnología?</em></h1>
			<p class="sub" style="color:#fff;font-weight:500">
				Amplía tus habilidades técnicas y forma equipo con otras mujeres.
			</p>
			<p class="sub" style="margin-top:12px">
				Te invitamos a unirte a nuestra comunidad y formar parte de un grupo de mujeres que se apoyan y se
				inspiran mutuamente.
			</p>
			<div class="ctas">
				<a class="btn p" href="/mentorias">Pedí tu mentoría →</a>
				<a class="btn s" href={links.discord} target="_blank" rel="noopener noreferrer">Sumate al Discord</a>
			</div>
			<div class="tags">{tags.map((t) => <span>{t}</span>)}</div>
		</div>
		<div class="term" aria-label="Demo de la comunidad">
			<div class="tb">
				<i style="background:#FF5F57"></i><i style="background:#FFBD2E"></i><i style="background:#28C840"></i>
				<span style="margin-left:8px">~/mermelada — zsh</span>
			</div>
			<pre id="term"></pre>
		</div>
	</div>
</section>

<script>
	const lines: [string, number][] = [
		['<span class="g">➜</span> <span class="c">mermelada</span> join --nombre <span class="y">"Luciana"</span>', 0],
		['<span class="d">✓</span> Bienvenida, Luciana 👋', 400],
		['<span class="d">✓</span> Canal asignado: <span class="v">#frontend</span>', 300],
		['<span class="d">✓</span> Espacio seguro: <span class="v">activado</span>', 300],
		["", 200],
		['<span class="g">➜</span> <span class="c">mermelada</span> mentoria --buscar data', 700],
		['<span class="d">→</span> Match: <span class="y">Sol G.</span> · AI &amp; Data Engineer · Aliada LATAM', 500],
		['<span class="d">→</span> Franja: <span class="v">tarde</span> · coordinamos por mail', 300],
		["", 200],
		['<span class="g">➜</span> <span class="cur"></span>', 400],
	];
	const el = document.getElementById("term");
	if (el) {
		if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
			el.innerHTML = lines.map((l) => l[0]).join("\n");
		} else {
			let i = 0;
			const next = () => {
				if (i >= lines.length) return;
				el.innerHTML += (i ? "\n" : "") + lines[i][0];
				i++;
				if (i < lines.length) setTimeout(next, lines[i][1]);
			};
			setTimeout(next, 500);
		}
	}
</script>
