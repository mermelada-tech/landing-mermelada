---
import { links } from "../data/links";

const plats = [
	{ name: "Discord", sub: "el centro de todo", href: links.discord },
	{ name: "Patreon", sub: "apoyá el proyecto", href: links.patreon },
	{ name: "Twitch", sub: "streams", href: links.twitch },
	{ name: "YouTube", sub: "cursos y charlas", href: links.youtube },
	{ name: "GitHub", sub: "proyectos open source", href: links.github },
];
---

<section id="plataformas">
	<div class="wrap">
		<div class="sec-head">
			<div><p class="eyebrow">Dónde estamos</p><h2>Las plataformas de la comunidad.</h2></div>
		</div>
		<div class="plat">
			{
				plats.map((p) => (
					<a href={p.href} target="_blank" rel="noopener noreferrer">
						<b>{p.name}</b>
						<small>{p.sub}</small>
					</a>
				))
			}
		</div>
	</div>
</section>
