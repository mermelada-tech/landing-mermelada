---
import { links } from "../data/links";

const testimonios = [
	{
		name: "Luciana G.",
		role: "frontend developer",
		color: "var(--rasp)",
		text: "Encontré un espacio donde puedo preguntar sin miedo y recibir respuestas con buena onda. Nunca me sentí menos por no saber algo.",
		reactions: ["💜 24", "🔥 9"],
	},
	{
		name: "Mariana P.",
		role: "data analyst",
		color: "var(--cyan)",
		text: "Mi mentora me ayudó a armar el portfolio y en dos meses conseguí mi primera entrevista técnica. Y la pasé.",
		reactions: ["💜 41", "🎉 17"],
	},
	{
		name: "Vale S.",
		role: "estudiante · QA",
		color: "var(--grape-300)",
		text: "Pregunté algo que me daba vergüenza y en diez minutos tenía tres respuestas y cero juicio. Así da gusto aprender.",
		reactions: ["💜 18", "👀 6"],
	},
];
---

<section id="testimonios" style="background:var(--ink-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
	<div class="wrap">
		<div class="sec-head">
			<div><p class="eyebrow">#general · Discord</p><h2>La comunidad anda diciendo</h2></div>
		</div>
		<div class="chat">
			{
				testimonios.map((t) => (
					<div class="card bubble" style="background:var(--ink)">
						<div class="h">
							<i style={`background:${t.color}`} />
							<div>
								<b>{t.name}</b>
								<small>{t.role}</small>
							</div>
						</div>
						<p>{t.text}</p>
						<div class="r">
							{t.reactions.map((r) => (
								<span>{r}</span>
							))}
						</div>
					</div>
				))
			}
		</div>
		<div class="ctas" style="justify-content:center;margin-top:40px">
			<a class="btn p" href={links.discord} target="_blank" rel="noopener noreferrer">Nos vemos en Discord →</a>
		</div>
	</div>
</section>
