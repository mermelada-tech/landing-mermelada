---
import CalEmbed from "./CalEmbed.tsx";

interface Sesion {
	n: string;
	nombre: string;
	descripcion: string;
	output: string;
}

const sesiones: Sesion[] = [
	{
		n: "1",
		nombre: "CLARITY",
		descripcion: "Dónde estás y hacia dónde vas.",
		output: "Clarity Map",
	},
	{
		n: "2",
		nombre: "STRATEGY",
		descripcion: "Plan de 90 días con hitos.",
		output: "Roadmap de 90 días",
	},
	{
		n: "3",
		nombre: "RITMO",
		descripcion: "Checkpoint a mitad de camino + plan de sostenibilidad.",
		output: "Plan de sostenibilidad",
	},
];

const precios = [
	{ label: "1 sesión", precio: "65€", destacado: false },
	{ label: "Pack 3 sesiones", precio: "170€", destacado: true },
	{ label: "Sesión inicial (20 min)", precio: "Gratis", destacado: false },
];

// PUBLIC_ vars are inlined at build time and safe to expose client-side.
const calLink = import.meta.env.PUBLIC_CALCOM_LINK ?? "";
---

<section id="mentorias" class="py-20 px-6 scroll-mt-20">
	<div class="max-w-5xl mx-auto">
		<div class="text-center">
			<span class="text-merme-purple font-semibold uppercase tracking-wide text-sm">Mentorías 1:1</span>
			<h2 class="text-merme-black text-4xl sm:text-5xl mt-2">Acompañamiento personalizado, conmigo</h2>
			<p class="text-merme-black/85 text-lg mt-3 max-w-2xl mx-auto">
				Un proceso en tres etapas para pasar de la confusión a un plan que podés sostener.
			</p>
		</div>

		<!-- Estructura CLARITY → STRATEGY → RITMO -->
		<div class="grid md:grid-cols-3 gap-6 mt-12">
			{
				sesiones.map((s) => (
					<article class="merme-card p-6">
						<div class="flex items-center gap-3">
							<span class="flex-shrink-0 w-10 h-10 grid place-items-center bg-merme-sunflower border-[1.5px] border-merme-black rounded-full font-bold">
								{s.n}
							</span>
							<h3 class="text-merme-black text-xl">{s.nombre}</h3>
						</div>
						<p class="text-merme-black/85 mt-4">{s.descripcion}</p>
						<p class="text-sm font-semibold text-merme-purple mt-4">
							Output: <span class="text-merme-black">{s.output}</span>
						</p>
					</article>
				))
			}
		</div>

		<!-- Precios -->
		<div class="grid sm:grid-cols-3 gap-4 mt-8">
			{
				precios.map((p) => (
					<div
						class:list={[
							"merme-card p-5 text-center",
							p.destacado && "bg-merme-sunflower",
						]}
					>
						<p class="font-semibold text-merme-black/80">{p.label}</p>
						<p class="text-merme-black text-3xl font-bold mt-1" style="font-family: var(--font-heading)">
							{p.precio}
						</p>
					</div>
				))
			}
		</div>

		<!-- Cal.com embed -->
		<div class="mt-12">
			<h3 class="text-merme-black text-2xl text-center mb-2">Reservá tu sesión inicial gratuita</h3>
			<p class="text-center text-merme-black/75 mb-6">
				20 minutos para ver si hay fit. Horario en <strong>Europe/Madrid</strong>.
			</p>
			<div class="merme-card p-2 sm:p-4 overflow-hidden">
				<div class="cal-embed-wrap min-h-[600px] h-[70vh]">
					<CalEmbed calLink={calLink} client:load />
				</div>
			</div>
		</div>
	</div>
</section>

<style is:global>
	/* Astro wraps the React island in <astro-island>, which is display:inline by
	   default — that collapses the embed's height:100% to 0 (blank render).
	   Force the wrapper chain to fill the sized container. */
	.cal-embed-wrap > astro-island,
	.cal-embed-wrap > astro-island > div {
		display: block;
		height: 100%;
	}
</style>
