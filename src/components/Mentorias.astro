---
import { mentoras } from "../data/mentoras";
---

<section class="ment" id="mentorias">
	<div class="wrap grid">
		<div>
			<p class="eyebrow">Mentorías 1:1 · piloto 2026</p>
			<h2>Una mentora que ya pasó <em>por donde estás vos.</em></h2>
			<p class="p">
				Sesiones gratuitas de 45 minutos por Discord o Meet. Elegís mentora, nos decís tu franja horaria y
				coordinamos.
			</p>
			<div class="ctas">
				<a class="btn p" href="/mentorias">Pedí tu mentoría →</a>
				<a class="btn s" href="/mentorias#ser-mentora">Quiero ser mentora</a>
			</div>
		</div>
		<div class="mentoras">
			{
				mentoras.map((m) => (
					<a class="mentora" href={`/mentorias#${m.id}`}>
						<img class="av" src={m.photo} alt={m.name} />
						<div>
							<b>{m.name}</b>
							<small>{m.role}</small>
							<div class="st">
								{m.tags.slice(0, 3).map((t) => (
									<span class="chip">{t}</span>
								))}
							</div>
						</div>
					</a>
				))
			}
		</div>
	</div>
</section>
