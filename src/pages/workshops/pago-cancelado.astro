---
import { getWorkshop } from "../../data/workshops";
import Layout from "../../layouts/Layout.astro";

const slug = Astro.url.searchParams.get("slug") ?? "";
const workshop = getWorkshop(slug);
const DISCORD_URL = "https://discord.gg/HFV4QXJKNh";
---

<Layout title="Pago cancelado — Mermelada Tech">
	<section class="min-h-[70vh] grid place-items-center px-6 py-20">
		<div class="merme-card max-w-lg w-full p-8 sm:p-10 text-center">
			<div class="text-5xl mb-4" aria-hidden="true">🫶</div>
			<h1 class="text-merme-black text-3xl sm:text-4xl">Cancelaste el pago</h1>

			<p class="text-merme-black/85 mt-4">
				No pasa nada, no se hizo ningún cargo.
				{workshop && (
					<>
						El cupo para <strong>{workshop.titulo}</strong> sigue disponible cuando quieras.
					</>
				)}
			</p>

			<p class="text-merme-black/85 mt-3">
				¿Dudas antes de anotarte? Escribinos por Discord y lo charlamos.
			</p>

			<div class="flex flex-col sm:flex-row gap-3 justify-center mt-8">
				<a href="/#workshops" class="merme-btn">Volver a los workshops</a>
				<a href={DISCORD_URL} target="_blank" rel="noopener noreferrer" class="merme-btn merme-btn--ghost">
					Preguntar por Discord
				</a>
			</div>
		</div>
	</section>
</Layout>
