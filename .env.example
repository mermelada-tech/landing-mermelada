# ─────────────────────────────────────────────────────────────
# Mermelada Tech — variables de entorno
# Copiá este archivo a `.env` y completá los valores.
# Empezá SIEMPRE en modo test de Stripe (claves sk_test_ / pk_test_).
# ─────────────────────────────────────────────────────────────

# Stripe — clave SECRETA (solo server-side, NUNCA en el cliente).
STRIPE_SECRET_KEY=sk_test_xxx

# Stripe — clave publicable (no se usa server-side, pero la dejamos para
# integraciones futuras de Stripe.js en el cliente).
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Stripe — secret del webhook (lo da `stripe listen` o el Dashboard).
STRIPE_WEBHOOK_SECRET=whsec_xxx

# URL pública del sitio (sin barra final). Se usa para los success/cancel URLs.
# En local: http://localhost:4321
PUBLIC_SITE_URL=http://localhost:4321

# Cal.com — tu enlace de reserva, formato "usuario/event-type".
# Ej: mermelada-tech-fdztum/sesion-inicial-gratuita
PUBLIC_CALCOM_LINK=mermelada-tech-fdztum/sesion-inicial-gratuita

# Supabase — proyecto landing-mermelada (eu-west-3).
# URL: Settings → API → Project URL
SUPABASE_URL=https://cdqezzpqlhbcctlqzhyt.supabase.co
# Service Role Key: Settings → API → service_role (NUNCA en el cliente).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Resend — para mandar el email a la lista de espera.
# Creá cuenta en resend.com, verificá tu dominio y generá una API key.
RESEND_API_KEY=re_xxx
# Remitente verificado en Resend (el dominio debe estar verificado en Resend).
# Usá solo ASCII en el nombre para que no aparezcan caracteres raros (=, ?) en
# el "From" de algunos clientes de correo.
RESEND_FROM_EMAIL=Nai de Mermelada Tech <nai@mermeladatech.com>
# ID del Audience de Resend Broadcasts para el newsletter (Resend → Audiences).
RESEND_AUDIENCE_ID=

# Clave para proteger el endpoint POST /api/waitlist/blast.
# Generá una cadena aleatoria larga: openssl rand -hex 32
BLAST_SECRET=cambia_esto_por_un_secreto_largo
